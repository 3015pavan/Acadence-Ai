DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/student_analytics
DB_SCHEMA=student_app
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=students_index
EMBEDDING_PROVIDER=local
AI_VECTOR_DIMENSION=384
AI_INTENT_THRESHOLD=0.2
REDIS_URL=redis://localhost:6379/0
QUERY_CACHE_TTL_SECONDS=300
VITE_API_BASE_URL=http://localhost:8000
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_FROM=your_email@example.com
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password
AGENT_POLL_MINUTES=5
AGENT_AUTO_START=false
EMAIL_AGENT_MAX_ATTACHMENT_MB=15
GCP_GEMINI_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_LEVEL=low
